# NyayaNow frontend — AI assist configuration.
# These are the ONLY AI variables the client knows. No API keys here:
# the key lives server-side in the worker (worker/.dev.vars or a Worker secret).

# Enable AI assist in the build (the user still opts in per-session).
VITE_AI_ENABLED=true

# Public URL of the deployed classification proxy (see worker/README.md).
VITE_AI_ENDPOINT=https://nyayanow-classify.your-subdomain.workers.dev
